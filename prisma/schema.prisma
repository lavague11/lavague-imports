// La Vague Imports — commerce schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([position])
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  tagline       String?
  description   String
  /// Country or region of origin, e.g. "Morocco", "Egypt".
  origin        String?
  brand         String?
  imageUrl      String?
  /// Up to three product photos. The first mirrors imageUrl (the card/primary
  /// shot); the rest form the detail-page gallery.
  images        String[]
  /// Internal: which import source the product came from (e.g. "wix",
  /// "halalco", "yemen"). Admin-only; not shown on the storefront.
  source        String?
  /// Lowest variant price in cents (null when quote-only), denormalized for
  /// price sorting.
  minPriceCents Int?
  /// Freeform storefront ribbon straight from the source catalog, e.g.
  /// "Best Seller", "HOT ITEM", "Only 2 Left". Null when the product has none.
  ribbon        String?
  /// Every raw source collection this product belongs to, used for the shop's
  /// collection filters. The single `category` below is its primary, curated home.
  collections   String[]
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  /// True for breakable items (glass bottles/jars) so the storefront can flag
  /// them and wholesale packing can handle them with care.
  isFragile     Boolean  @default(false)
  /// Admin-only landed cost (what we buy it for), in cents. Drives the pricing
  /// tool's profit/margin. Never shown on the storefront.
  costCents     Int?
  /// True for products created in the admin portal (not from an imported
  /// source). The seed reset spares these so they survive a re-import.
  isCustom      Boolean  @default(false)
  position      Int      @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // --- Wholesale channel (Part 6). One canonical catalog; these flags/fields
  // control B2B visibility and pricing. retail* mirrors the storefront defaults.
  /// Whether the product is offered to retail customers (the public storefront).
  retailEnabled       Boolean @default(true)
  /// Whether the product is offered in the wholesale catalog. Only these appear
  /// to approved wholesale accounts.
  wholesaleEnabled    Boolean @default(false)
  /// Base wholesale (per-unit) price in cents before tier/account overrides.
  wholesalePriceCents Int?
  /// Manufacturer's suggested retail price, for reference on wholesale sheets.
  msrpCents           Int?
  /// Minimum order quantity (units) for wholesale.
  moqUnits            Int?
  /// Units per case for wholesale ordering.
  casePack            Int?
  /// Supplier / vendor name (admin-only).
  supplier            String?
  /// On-hand stock in units (admin-only, best-effort).
  stockUnits          Int?
  /// Typical lead time in days when out of stock (admin-only).
  leadTimeDays        Int?

  variants      ProductVariant[]
  accountPrices AccountProductPrice[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([categoryId])
  @@index([isFeatured])
  @@index([wholesaleEnabled])
}

/// A purchasable size/pack of a product. Prices are stored in cents to avoid
/// floating point rounding errors.
model ProductVariant {
  id        String  @id @default(cuid())
  sku       String  @unique
  name      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Null means "price on request" — most wholesale lines are quoted, not
  /// listed. The storefront shows a request-a-quote call to action instead.
  retailPriceCents    Int?
  /// Original price when the variant is on sale; shown struck through.
  compareAtPriceCents Int?
  /// Per-case price offered to approved wholesale accounts.
  casePriceCents      Int?
  unitsPerCase        Int?
  /// Minimum number of cases a wholesale account must order.
  minOrderCases       Int?

  inStock  Boolean @default(true)
  position Int     @default(0)

  quoteItems QuoteItem[]

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Quote requests (the storefront cart submits one of these instead of a payment)
// ---------------------------------------------------------------------------

enum CustomerType {
  RETAIL
  WHOLESALE
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  QUOTED
  WON
  LOST
}

model QuoteRequest {
  id        String @id @default(cuid())
  /// Human-friendly reference shown to the customer, e.g. "LVQ-7K3M2A".
  reference String @unique

  customerType CustomerType @default(RETAIL)
  name         String
  email        String
  phone        String
  company      String?
  message      String?

  deliveryCity       String?
  deliveryState      String?
  deliveryPostalCode String?

  status              QuoteStatus @default(NEW)
  /// Sum of the line items at list price, before any negotiated discount.
  estimatedTotalCents Int         @default(0)
  items               QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  /// Nulled out if the variant is later deleted; the snapshot fields below keep
  /// the quote readable regardless.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  variantName String
  sku         String

  quantity       Int
  /// Null for quote-only lines with no listed price. estimatedTotalCents on the
  /// parent then reflects only the lines that do carry a price.
  unitPriceCents Int?
  lineTotalCents Int?

  @@index([quoteRequestId])
}

// ---------------------------------------------------------------------------
// Wholesale applications
// ---------------------------------------------------------------------------

enum BusinessType {
  RESTAURANT
  GROCERY
  DISTRIBUTOR
  CAFE
  CATERER
  OTHER
}

enum ApplicationStatus {
  NEW
  IN_REVIEW
  APPROVED
  REJECTED
}

model WholesaleApplication {
  id        String @id @default(cuid())
  reference String @unique

  businessName String
  businessType BusinessType
  contactName  String
  email        String
  phone        String
  website      String?

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String

  /// EIN / federal tax ID, collected for resale certificate verification.
  taxId            String?
  resaleCertNumber String?

  estimatedMonthlyVolume String?
  productInterest        String[]
  message                String?

  status    ApplicationStatus @default(NEW)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// General enquiries
// ---------------------------------------------------------------------------

enum ContactTopic {
  GENERAL
  WHOLESALE
  ORDER
  PRODUCT
  DELIVERY
}

model ContactMessage {
  id        String @id @default(cuid())
  reference String @unique

  name    String
  email   String
  phone   String?
  topic   ContactTopic @default(GENERAL)
  message String

  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Stores & delivery — not surfaced in the storefront yet, modelled now so the
// future multi-store delivery rollout doesn't need a destructive migration.
// ---------------------------------------------------------------------------

model Store {
  id   String @id @default(cuid())
  slug String @unique
  name String

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  phone        String?
  email        String?

  latitude  Float?
  longitude Float?

  /// Opening hours keyed by weekday, e.g. { "mon": ["09:00", "17:00"] }.
  openingHours Json?
  isActive     Boolean @default(true)

  deliveryZones DeliveryZone[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model DeliveryZone {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name        String
  postalCodes String[]

  deliveryFeeCents           Int  @default(0)
  freeDeliveryThresholdCents Int?
  minOrderCents              Int  @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// ---------------------------------------------------------------------------
// Admin portal — accounts and durable catalog edits (overrides layer)
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMIN
  EDITOR
  /// Account Executive — operates the wholesale relationship (accounts, quotes,
  /// orders, collections). Sees a focused workspace, not every owner tool.
  AE
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(EDITOR)
  /// Fine-grained server-enforced permissions (e.g. "record_payment",
  /// "void_invoice"). ADMIN implicitly has all; others are granted explicitly.
  capabilities String[]  @default([])
  /// Shown on the AE's records, e.g. "Senior Account Executive".
  title        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions AdminSession[]

  // Account Executive relations (this staff member acting as the AE).
  managedAccounts BusinessAccount[] @relation("AccountExecutive")
  quotes          Quote[]           @relation("QuoteAE")
  wholesaleOrders WholesaleOrder[]  @relation("OrderAE")
  invoices        Invoice[]         @relation("InvoiceAE")
  tasks           AccountTask[]     @relation("TaskAssignee")
}

model AdminSession {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Admin-uploaded / localized product photos, stored in the database so they
/// survive redeploys (the server's public/ dir is rebuilt on every deploy).
/// Served by the /media/[id] route.
model MediaAsset {
  id          String   @id @default(cuid())
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}

/// Pre-built full catalog PDFs, keyed by sort mode ("full-country" /
/// "full-category"). Served instantly for the unfiltered download; filtered
/// selections are still generated on demand.
model CatalogCache {
  key     String   @id
  data    Bytes
  count   Int      @default(0)
  builtAt DateTime @default(now())
}

/// Cached JPEG thumbnail for a product image, keyed by its source URL/path.
/// Lets the PDF catalog reuse resized images instead of re-encoding every time.
model ImageThumb {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now())
}

/// A researched competitor price for a product, powering the price-comparison
/// portal (Amazon / Walmart / eBay / specialty).
model PriceComparison {
  id          String   @id @default(cuid())
  productSlug String
  source      String
  priceCents  Int
  url         String?
  checkedAt   DateTime @default(now())

  @@index([productSlug])
}

/// A customer's request to be emailed when an out-of-stock product returns.
model StockNotification {
  id          String   @id @default(cuid())
  email       String
  productSlug String
  productName String
  variantSku  String?
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productSlug])
  @@index([notified])
}

/// Durable admin edits, keyed by product slug. Only set fields override the
/// generated catalog; the seed re-applies these after re-importing sources.
model ProductOverride {
  id   String @id @default(cuid())
  slug String @unique

  name              String?
  tagline           String?
  description       String?
  imageUrl          String?
  /// Up to three product photos (JSON array of paths/URLs). Overrides the whole
  /// gallery when set.
  images            Json?
  /// A best-effort image candidate from scripts/suggest-images.mjs, shown for
  /// approval in the edit form. Never applied automatically.
  suggestedImageUrl String?
  origin            String?
  ribbon            String?
  categorySlug      String?
  isFeatured        Boolean?
  isActive          Boolean?
  isFragile         Boolean?
  costCents         Int?
  /// Per-variant retail price overrides, keyed by SKU: { "<sku>": <cents> }.
  variantPrices     Json?
  /// Per-variant pack overrides, keyed by SKU:
  /// { "<sku>": { "size": "70 g", "unitsPerCase": 24 } }.
  variantPacks      Json?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===========================================================================
// WHOLESALE B2B SYSTEM  (Phase 1 foundation — the canonical spine)
//
// One connected workflow, read by every lens (AE / A/R / Operations):
//   BusinessAccount → Contacts → AccountExecutive
//     → Quote → WholesaleOrder → Invoice → Payment → Delivery
//   with Documents, Tasks, and Activity hanging off the account.
//
// Design rules (from the spec): keep ONE canonical catalog (see Product above);
// money is always integer cents; each lifecycle has its OWN status enum (never a
// single generic status); financial writes must be transactional (see Payment).
// ===========================================================================

/// Sequential number generator. One row per series ("account", "quote",
/// "order", "invoice", "delivery"); increment inside a transaction to mint the
/// next human id (e.g. Q-10001). Values start at 10000 so ids read as 5 digits.
model Counter {
  key   String @id
  value Int    @default(10000)
}

/// Named pricing level (e.g. "Dealer", "Distributor"). A tier can express a
/// blanket percent-off wholesale; exact per-product prices live in
/// AccountProductPrice. Pricing priority: account price > tier > base wholesale.
model PricingTier {
  id                  String            @id @default(cuid())
  name                String            @unique
  /// Whole-number percent off the base wholesale price (0–100). Null = no blanket discount.
  percentOffWholesale Int?
  position            Int               @default(0)
  accounts            BusinessAccount[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

enum AccountStatus {
  LEAD
  PENDING_APPROVAL
  ACTIVE
  ON_HOLD
  INACTIVE
}

enum PipelineStage {
  LEAD
  QUALIFIED
  WHOLESALE_APPROVED
  QUOTED
  NEGOTIATING
  ORDERED
  ACTIVE_ACCOUNT
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET_7
  NET_15
  NET_30
  NET_45
  CUSTOM
}

/// The canonical business customer. Do NOT create separate customer records per
/// employee — employees are Contacts under one account.
model BusinessAccount {
  id           String        @id @default(cuid())
  /// Human id, e.g. "ACC-10001".
  reference    String        @unique
  companyName  String
  status       AccountStatus @default(LEAD)
  stage        PipelineStage @default(LEAD)
  businessType BusinessType?

  taxId            String?
  resaleCertNumber String?

  // Billing address (inline). Shipping addresses are a related list.
  billingLine1      String?
  billingLine2      String?
  billingCity       String?
  billingState      String?
  billingPostalCode String?

  pricingTierId String?
  pricingTier   PricingTier? @relation(fields: [pricingTierId], references: [id], onDelete: SetNull)

  paymentTerms     PaymentTerms @default(DUE_ON_RECEIPT)
  /// Custom terms wording when paymentTerms = CUSTOM.
  paymentTermsNote String?
  creditLimitCents Int?

  internalNotes  String?
  /// Follow-up reminder surfaced on the account overview.
  nextFollowUpAt DateTime?

  accountExecutiveId String?
  accountExecutive   AdminUser? @relation("AccountExecutive", fields: [accountExecutiveId], references: [id], onDelete: SetNull)

  /// Set when the account originated from an approved wholesale application.
  sourceApplicationId String?

  contacts          BusinessContact[]
  shippingAddresses ShippingAddress[]
  accountPrices     AccountProductPrice[]
  quotes            Quote[]
  orders            WholesaleOrder[]
  invoices          Invoice[]
  payments          Payment[]
  deliveries        Delivery[]
  documents         AccountDocument[]
  tasks             AccountTask[]
  activity          AccountActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([accountExecutiveId])
  @@index([stage])
}

enum ContactRole {
  OWNER
  BUYER
  ACCOUNTS_PAYABLE
  STORE_MANAGER
  RECEIVING
  OTHER
}

model BusinessContact {
  id        String          @id @default(cuid())
  accountId String
  account   BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name      String
  title     String?
  email     String?
  phone     String?
  role      ContactRole @default(OTHER)
  isPrimary Boolean     @default(false)

  quotes Quote[]
  orders WholesaleOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model ShippingAddress {
  id        String          @id @default(cuid())
  accountId String
  account   BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  isDefault  Boolean @default(false)

  @@index([accountId])
}

/// Exact per-account price override for a product. Highest pricing priority.
/// Never mutates the product's global wholesale price.
model AccountProductPrice {
  id         String          @id @default(cuid())
  accountId  String
  account    BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, productId])
  @@index([productId])
}

// ---- Quotes (wholesale estimates) ----------------------------------------

enum QuoteState {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

model Quote {
  id        String @id @default(cuid())
  reference String @unique // "Q-10001"
  /// Bumped on each material revision; an accepted quote is never silently mutated.
  version   Int    @default(1)

  accountId          String
  account            BusinessAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            BusinessContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  accountExecutiveId String?
  accountExecutive   AdminUser?       @relation("QuoteAE", fields: [accountExecutiveId], references: [id], onDelete: SetNull)

  state QuoteState @default(DRAFT)

  subtotalCents Int @default(0)
  discountCents Int @default(0)
  shippingCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)

  notes       String?
  expiresAt   DateTime?
  /// Secure random token for the customer accept/sign link.
  publicToken String?   @unique

  items      QuoteLine[]
  acceptance QuoteAcceptance?
  order      WholesaleOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([state])
  @@index([accountExecutiveId])
}

model QuoteLine {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Snapshot so the line stays readable if the product/variant later changes.
  productId   String?
  variantId   String?
  productName String
  variantName String?
  sku         String?

  quantity       Int
  unitPriceCents Int
  /// Source of the unit price for audit: "account" | "tier" | "wholesale" | "manual".
  priceSource    String @default("wholesale")
  lineTotalCents Int

  @@index([quoteId])
}

/// Immutable record of a customer accepting/signing a specific quote version.
model QuoteAcceptance {
  id      String @id @default(cuid())
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  signerName          String
  /// Data-URL or stored signature reference.
  signature           String?
  quoteVersion        Int
  /// Hash of the accepted document, so later edits are provably a new revision.
  documentFingerprint String?
  acceptedAt          DateTime @default(now())
}

// ---- Wholesale orders -----------------------------------------------------

enum OrderState {
  DRAFT
  SUBMITTED
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELED
}

enum OrderPaymentState {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERPAID
  REFUNDED
  VOID
}

enum FulfillmentState {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  SHIPPED
  DELIVERED
}

model WholesaleOrder {
  id        String @id @default(cuid())
  reference String @unique // "WH-10001"

  accountId          String
  account            BusinessAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            BusinessContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  accountExecutiveId String?
  accountExecutive   AdminUser?       @relation("OrderAE", fields: [accountExecutiveId], references: [id], onDelete: SetNull)

  /// Lineage back to the quote it converted from (if any).
  quoteId String? @unique
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  // Three independent lifecycles — never collapse into one status (Part 34).
  state            OrderState        @default(DRAFT)
  paymentState     OrderPaymentState @default(UNPAID)
  fulfillmentState FulfillmentState  @default(UNFULFILLED)

  poNumber String?

  subtotalCents Int @default(0)
  discountCents Int @default(0)
  shippingCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)

  notes String?

  items          OrderLine[]
  supplierGroups SupplierFulfillmentGroup[]
  invoices       Invoice[]
  deliveries     Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([state])
  @@index([paymentState])
  @@index([accountExecutiveId])
}

model OrderLine {
  id      String         @id @default(cuid())
  orderId String
  order   WholesaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String?
  variantId   String?
  productName String
  variantName String?
  sku         String?
  supplier    String?

  quantity       Int
  unitPriceCents Int
  lineTotalCents Int

  supplierGroupId String?
  supplierGroup   SupplierFulfillmentGroup? @relation(fields: [supplierGroupId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum SupplierState {
  PENDING
  ORDERED
  CONFIRMED
  BACKORDERED
  SHIPPED
  DELIVERED
  CANCELED
}

/// Internal split of one customer-facing order across suppliers. The customer
/// still sees a single La Vague order.
model SupplierFulfillmentGroup {
  id       String         @id @default(cuid())
  orderId  String
  order    WholesaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier String
  state    SupplierState  @default(PENDING)
  notes    String?
  lines    OrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

// ---- Invoices / Accounts Receivable ---------------------------------------

enum InvoiceState {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id        String @id @default(cuid())
  reference String @unique // "INV-10001"

  accountId          String
  account            BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId            String?
  order              WholesaleOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  accountExecutiveId String?
  accountExecutive   AdminUser?      @relation("InvoiceAE", fields: [accountExecutiveId], references: [id], onDelete: SetNull)

  state InvoiceState @default(DRAFT)

  // Billing / shipping snapshots so the invoice stays fixed once issued.
  billTo   String?
  shipTo   String?
  poNumber String?

  paymentTerms PaymentTerms @default(DUE_ON_RECEIPT)
  invoiceDate  DateTime     @default(now())
  dueDate      DateTime?

  subtotalCents   Int @default(0)
  discountCents   Int @default(0)
  shippingCents   Int @default(0)
  taxCents        Int @default(0)
  totalCents      Int @default(0)
  /// Denormalized, kept in sync with allocations inside a transaction (Part 33).
  amountPaidCents Int @default(0)
  balanceCents    Int @default(0)

  notes      String?
  /// Set on a material edit after issue, so financial history isn't rewritten.
  revisionOf String?

  items       InvoiceLine[]
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([state])
  @@index([dueDate])
  @@index([accountExecutiveId])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description    String
  sku            String?
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int

  @@index([invoiceId])
}

// ---- Payments -------------------------------------------------------------

enum PaymentMethod {
  CHECK
  CASH
  CARD
  ACH
  WIRE
  OTHER
}

enum CheckState {
  RECEIVED
  PENDING_DEPOSIT
  DEPOSITED
  CLEARED
  RETURNED
}

model Payment {
  id        String @id @default(cuid())
  reference String @unique // "PAY-10001"

  accountId String
  account   BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  method      PaymentMethod
  amountCents Int
  receivedAt  DateTime      @default(now())
  /// External reference (check #, ACH trace, card auth, wire ref).
  externalRef String?
  /// Name of the staff member who took the payment (snapshot, not a FK).
  receivedBy  String?
  notes       String?

  // Check-specific (null for other methods).
  checkNumber String?
  checkDate   DateTime?
  bankName    String?
  checkState  CheckState?

  /// Positive when the payment exceeds what it was applied to — recorded as
  /// account credit rather than silently lost (Part 15).
  unappliedCents Int @default(0)

  allocations PaymentAllocation[]
  documents   PaymentDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([method])
  @@index([checkState])
}

/// Applies part (or all) of a payment to a specific invoice. Sum of a payment's
/// allocations + unapplied = its amount; sum of an invoice's allocations =
/// amountPaid. Written atomically with the invoice balance/state (Part 33).
model PaymentAllocation {
  id          String  @id @default(cuid())
  paymentId   String
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents Int

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

/// A file attached to a payment (e.g. a photo of a check). Bytes live in
/// MediaAsset; this row holds the metadata and visibility. Staff-only.
model PaymentDocument {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  mediaId   String
  label     String?
  createdAt DateTime @default(now())

  @@index([paymentId])
}

// ---- Delivery / proof of delivery -----------------------------------------

model Delivery {
  id        String @id @default(cuid())
  reference String @unique // "DEL-10001"

  accountId String
  account   BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId   String?
  order     WholesaleOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  deliveredAt DateTime?
  deliveredBy String?
  receivedBy  String?
  /// Recipient signature (data-URL or stored reference).
  signature   String?
  signedAt    DateTime?
  notes       String?

  photos DeliveryPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([orderId])
}

enum DeliveryPhotoKind {
  PACKED
  LOADED
  DELIVERED
  DAMAGE
  OTHER
}

model DeliveryPhoto {
  id         String            @id @default(cuid())
  deliveryId String
  delivery   Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  mediaId    String
  kind       DeliveryPhotoKind @default(OTHER)
  caption    String?
  createdAt  DateTime          @default(now())

  @@index([deliveryId])
}

// ---- Documents, tasks, activity -------------------------------------------

enum DocumentKind {
  PACKING_SLIP
  DELIVERY_RECEIPT
  ORDER_PHOTO
  SIGNED_INVOICE
  PURCHASE_ORDER
  CHECK_COPY
  RESALE_CERT
  OTHER
}

model AccountDocument {
  id              String          @id @default(cuid())
  accountId       String
  account         BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind            DocumentKind    @default(OTHER)
  mediaId         String
  label           String?
  /// Whether the customer may see this in their portal.
  customerVisible Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@index([accountId])
}

enum TaskType {
  CALL
  EMAIL
  FOLLOW_UP
  PAYMENT
  QUOTE
  ORDER
  DELIVERY
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  CANCELED
}

model AccountTask {
  id         String          @id @default(cuid())
  accountId  String
  account    BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   AdminUser?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  type   TaskType   @default(FOLLOW_UP)
  status TaskStatus @default(OPEN)
  title  String
  notes  String?
  dueAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([assigneeId])
  @@index([status])
}

/// Append-only activity feed for an account — every meaningful event (quote
/// sent, invoice paid, payment recorded, delivery completed, price override…).
model AccountActivity {
  id         String          @id @default(cuid())
  accountId  String
  account    BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Event type, e.g. "quote.sent", "invoice.paid", "payment.recorded".
  type       String
  message    String
  /// Who did it (staff name snapshot), and optional linked record.
  actor      String?
  entityType String?
  entityId   String?
  createdAt  DateTime        @default(now())

  @@index([accountId])
  @@index([createdAt])
}
