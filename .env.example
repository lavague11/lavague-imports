# Copy to .env and fill in.
DATABASE_URL="postgresql://lavague:lavague@localhost:5432/lavague?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (optional) ---------------------------------------------------------
# Wires up staff notifications for quote/wholesale/contact submissions and the
# back-in-stock waitlist. Pick ONE provider:
#
# 1) Resend (HTTP API, simplest):
# RESEND_API_KEY="re_..."
#
# 2) SMTP (Hostinger email, Gmail app password, etc.):
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"            # 465 = implicit TLS, 587 = STARTTLS
# SMTP_USER="sales@lavagueimports.com"
# SMTP_PASS="..."
#
# Visible sender on outgoing mail (both providers):
# MAIL_FROM="La Vague Imports <sales@lavagueimports.com>"
# Where submission notifications land (defaults to the site's contact address):
# SALES_EMAIL="sales@lavagueimports.com"
